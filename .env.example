# ============================================
# VENDOR GO - ENVIRONMENT VARIABLES TEMPLATE
# ============================================
# Copy this file to .env and update with your actual values
# DO NOT commit .env file to version control
# 
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Update values with your configuration
# 3. Never share or commit .env file
# ============================================

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection details
# These must match the database you created with schema.sql
#
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vendor_go_db
DB_USER=vendor_go_user
DB_PASSWORD=your_secure_password_here

# Alternative: Use DATABASE_URL instead of individual variables
# DATABASE_URL=postgresql://vendor_go_user:your_secure_password@localhost:5432/vendor_go_db

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Node environment and server settings
#
NODE_ENV=development
PORT=3000
HOST=localhost

# ============================================
# SESSION CONFIGURATION
# ============================================
# Express-session middleware configuration
# SECRET: Random string for encrypting session data
#         Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
SESSION_SECRET=your-super-secret-session-key-change-this-min-32-chars
SESSION_RESAVE=false
SESSION_SAVE_UNINITIALIZED=true

# Session timeout in seconds (3600 = 1 hour)
SESSION_TIMEOUT=3600

# ============================================
# EMAIL CONFIGURATION (Nodemailer)
# ============================================
# Email service for sending OTP, notifications, order confirmations
# 
# FOR GMAIL:
# 1. Enable 2-Factor Authentication: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character App Password (with spaces removed)
# 4. Example: abcd efgh ijkl mnop → abcdefghijklmnop
#
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_specific_password_here
EMAIL_FROM=noreply@vendorgo.com

# Alternative email services:
# EMAIL_SERVICE=outlook
# EMAIL_SERVICE=yahoo
# EMAIL_SERVICE=custom (for custom SMTP servers)

# Custom SMTP settings (if using custom EMAIL_SERVICE):
# SMTP_HOST=smtp.custom.com
# SMTP_PORT=587
# SMTP_SECURE=false

# ============================================
# FILE UPLOAD CONFIGURATION
# ============================================
# Multer file upload settings
#
# UPLOAD_DIR: Directory where product images and user uploads are stored
#             Relative to project root
#             Must be writable and exist on the server
#
UPLOAD_DIR=./public/uploads

# MAX_FILE_SIZE: Maximum file size in bytes
#                5242880 = 5MB
#                10485760 = 10MB
#                Set appropriate limits based on server capacity
#
MAX_FILE_SIZE=5242880

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp

# ============================================
# OTP CONFIGURATION
# ============================================
# One-Time Password settings for customer verification
#
# OTP_LENGTH: Number of digits in OTP (6 is standard, 4-8 is acceptable)
OTP_LENGTH=6

# OTP_EXPIRY: How long OTP is valid in minutes
OTP_EXPIRY=10

# ============================================
# APPLICATION SETTINGS
# ============================================
# Feature-specific configurations
#
# Cart settings
CART_MAX_QUANTITY=100
CART_SESSION_NAME=cart

# Product settings
PRODUCT_PER_PAGE=12
PRODUCT_SEARCH_LIMIT=50

# Order settings
ORDER_CONFIRMATION_REQUIRED=true
ENABLE_REAL_TIME_NOTIFICATIONS=true

# ============================================
# SOCKET.IO CONFIGURATION
# ============================================
# Real-time communication settings
#
SOCKET_TRANSPORTS=websocket,polling
SOCKET_RECONNECTION_DELAY=1000
SOCKET_RECONNECTION_DELAY_MAX=5000

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Log file location
LOG_FILE=./logs/app.log

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Security-related settings
#
# JWT or Token expiry (if implementing JWT authentication)
TOKEN_EXPIRY=24h

# Password requirements
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_NUMBERS=true
PASSWORD_REQUIRE_SYMBOLS=false

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS settings
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# ============================================
# PAYMENT CONFIGURATION (Future Use)
# ============================================
# Placeholder for payment gateway integration
#
# STRIPE_PUBLIC_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# PAYPAL_CLIENT_ID=xxx
# PAYPAL_SECRET=xxx

# ============================================
# EXTERNAL SERVICES
# ============================================
# Third-party service integrations
#
# SMS Service (if implementing SMS OTP)
# SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=xxx
# TWILIO_AUTH_TOKEN=xxx
# TWILIO_PHONE_NUMBER=+1234567890

# Analytics
# GOOGLE_ANALYTICS_ID=UA-xxx
# SENTRY_DSN=https://xxx

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Development-only configurations
#
# Debug mode (verbose logging)
DEBUG=false
DEBUG_SQL=false

# Mock email (log instead of sending)
MOCK_EMAIL=false

# API documentation
SWAGGER_ENABLED=true
SWAGGER_PATH=/api-docs

# ============================================
# PRODUCTION SETTINGS
# ============================================
# Production-specific configurations
# Override NODE_ENV=development above to use these
#
# When NODE_ENV=production:
# - SSL/TLS enforcement
# - Strict security headers
# - Database connection pooling
# - Error logging to external service
# - Compressed responses
#

# SSL Configuration
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Database pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_TIMEOUT=30000

# ============================================
# FEATURE FLAGS
# ============================================
# Enable/disable features without code changes
#
FEATURE_VENDOR_REGISTRATION=true
FEATURE_CUSTOMER_REGISTRATION=true
FEATURE_ADMIN_DASHBOARD=true
FEATURE_REAL_TIME_ORDERS=true
FEATURE_EMAIL_NOTIFICATIONS=true
FEATURE_OTP_VERIFICATION=true
FEATURE_PRODUCT_IMAGES=true
FEATURE_CART_PERSISTENCE=true

# ============================================
# SAMPLE VALUES REFERENCE
# ============================================
# 
# Database:
#   DB_HOST: usually "localhost" for local, "db.example.com" for remote
#   DB_PORT: usually 5432 for PostgreSQL
#   DB_USER: created in schema.sql setup
#   DB_PASSWORD: custom password (min 12 chars for production)
#
# Email (Gmail):
#   EMAIL_USER: your gmail address
#   EMAIL_PASSWORD: 16-character App Password (from Google Account)
#   EMAIL_FROM: can be your gmail or custom sender name
#
# Upload:
#   Must create ./public/uploads directory before running app
#   chmod 755 public/uploads (on Unix/Linux/macOS)
#
# Session Secret:
#   Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   Minimum 32 characters for security
#
# PORT:
#   3000 is standard for development
#   Use 8080, 8081, etc. if 3000 is already in use
#
# ============================================
# VERIFICATION CHECKLIST
# ============================================
# Before running npm start:
# [ ] Database created and schema.sql executed
# [ ] All DB_ variables match PostgreSQL setup
# [ ] .env file is in project root
# [ ] EMAIL_SERVICE configured (can use mock for dev)
# [ ] SESSION_SECRET is a strong random string
# [ ] public/uploads directory exists and is writable
# [ ] All required variables are populated
# [ ] .env is added to .gitignore
#
# ============================================
